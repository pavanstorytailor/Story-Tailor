{"sections":{"main":{"type":"main-product","blocks":{"product_meta":{"type":"product_meta","settings":{"show_vendor":false,"show_sku":false,"show_product_rating":true,"show_taxes_included":false}},"bf_size_charts_block_qVmwwG":{"type":"shopify:\/\/apps\/bf-size-charts\/blocks\/block\/47ee4f2e-eb5e-41af-9beb-e2786646bf2a","settings":{}},"variant_selector_XcwH63":{"type":"variant_selector","settings":{"selector_mode":"block","show_color_swatch":false,"show_color_carousel":false,"size_chart":""}},"liquid_9cYdmx":{"type":"liquid","settings":{"liquid":"<span style=\"font-size:14px; color:red;\">* Please refer size chart<\/span>"}},"liquid_Cx3MXw":{"type":"liquid","name":"Size Chart ","settings":{"liquid":"{% comment %}\nStory Tailor - Size Guide Button + Modal\nOnly shows for: Girls, Boys, Infants, Sleepwear, T-shirt\nHidden for: Toys, Accessories, Flipbooks, and anything else\n\nPlace this block right after the Size\/Variant selector, before Quantity selector,\non the Product page template (Shopify theme editor > Add block > Custom Liquid).\n\nIMPORTANT: Replace the 5 image URLs below with your actual chart URLs.\nTo get them: Shopify Admin > Content > Files > upload each chart image >\nclick the uploaded file > copy the URL shown.\n{% endcomment %}\n\n{% assign show_size_guide = false %}\n{% assign chart_image = '' %}\n{% assign chart_label = '' %}\n\n{% for collection in product.collections %}\n  {% if collection.handle == 'sleepwear' %}\n    {% assign show_size_guide = true %}\n    {% assign chart_image = ' https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Size_Chart_-_Sleepwear.webp?v=1786612011' %}\n    {% assign chart_label = '' %}\n  {% elsif collection.handle == 'girls' %}\n    {% assign show_size_guide = true %}\n    {% assign chart_image = ' https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/size_chart-Girls.webp?v=1786612011' %}\n    {% assign chart_label = '' %}\n  {% elsif collection.handle == 'boys' %}\n    {% assign show_size_guide = true %}\n    {% assign chart_image = ' https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/size_chart-Boys.webp?v=1786612012 ' %}\n    {% assign chart_label = '' %}\n  {% elsif collection.handle == 'infants' %}\n    {% assign show_size_guide = true %}\n    {% assign chart_image = 'https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/size_charts-infants.webp?v=1786612323' %}\n    {% assign chart_label = '' %}\n  {% elsif collection.handle == 't-shirt' %}\n    {% assign show_size_guide = true %}\n    {% assign chart_image = ' https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Size_Chart_-_T_Shirt.webp?v=1786612012' %}\n    {% assign chart_label = '' %}\n  {% endif %}\n{% endfor %}\n\n{% if show_size_guide %}\n<button type=\"button\" class=\"st-size-guide-btn\" onclick=\"document.getElementById('st-size-modal').style.display='flex'\">\n  📏 View {{ chart_label }} Size Guide\n<\/button>\n\n<div id=\"st-size-modal\" style=\"display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center;\" onclick=\"this.style.display='none'\">\n  <div style=\"position:relative; max-width:90%; max-height:90%;\" onclick=\"event.stopPropagation()\">\n    <img src=\"{{ chart_image }}\" style=\"max-width:100%; max-height:80vh; border-radius:8px;\" alt=\"{{ chart_label }} size guide\">\n    <button type=\"button\" style=\"position:absolute; top:-12px; right:-12px; background:#7a1f1f; color:#fff; border:none; border-radius:50%; width:32px; height:32px; cursor:pointer; font-size:16px;\" onclick=\"document.getElementById('st-size-modal').style.display='none'\">✕<\/button>\n  <\/div>\n<\/div>\n\n<style>\n.st-size-guide-btn {\nbackground: none;\n    border: 1px solid #F7aba6;\n    color: #241F21;\n    padding: 8px 16px;\n    border-radius: 6px;\n    font-size: 14px;\n    cursor: pointer;\n    margin: 8px 0;\n    font-family: Poppins, sans-serif;\n    display: block;\n}\n.st-size-guide-btn:hover {\n  background: #F7ABA6;\n  color: white;\n}\n<\/style>\n{% endif %}"}},"quantity_selector":{"type":"quantity_selector","settings":{"show_label":true}},"xb_wishlist_button_wishlist_iYWMjD":{"type":"shopify:\/\/apps\/xb-wishlist\/blocks\/button_wishlist\/cc07f1e9-907b-431d-99f8-4fce3efa75f1","disabled":true,"settings":{}},"buy_buttons":{"type":"buy_buttons","settings":{"show_price_in_button":true,"show_payment_button":true}},"liquid_hDEFKD":{"type":"liquid","settings":{"liquid":"<span style=\"font-size:14px;\">\n🕑 Estimated Delivery between\n<script>\nlet futureDate1 = new Date();\nlet futureDate2 = new Date();\n\nfutureDate1.setDate(futureDate1.getDate() + 7);\nfutureDate2.setDate(futureDate2.getDate() + 10);\n\nconst options = {\n  day: '2-digit',\n  month: 'short'\n};\n\ndocument.write(\n  futureDate1.toLocaleDateString('en-GB', options) +\n  \" to \" +\n  futureDate2.toLocaleDateString('en-GB', options)\n);\n<\/script>\n<\/span>"}},"liquid_pyrTBQ":{"type":"liquid","settings":{"liquid":"<style>\n  \/* =========================\n     TRUST BADGE LAYOUT\n     3 × 3\n  ========================== *\/\n  .st-trust-badges {\n    display: flex;\n    flex-wrap: wrap;\n    margin: 14px 0;\n    padding: 12px 0;\n    border-top: 1px solid #eeeeee;\n    border-bottom: 1px solid #eeeeee;\n  }\n\n  .st-trust-badge {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n    text-align: center;\n    gap: 6px;\n\n    \/* Exactly 3 badges in one row *\/\n    flex: 0 0 33.333%;\n    max-width: 33.333%;\n\n    min-width: 0;\n    box-sizing: border-box;\n  }\n\n  \/* =========================\n     TRUST BADGE IMAGE\n  ========================== *\/\n  .st-trust-badge img {\n    display: block;\n    width: 100%;\n    max-width: 150px;\n    height: auto;\n    aspect-ratio: 1 \/ 1;\n    object-fit: contain;\n    flex-shrink: 0;\n  }\n\n  \/* =========================\n     EASY 7 DAY RETURNS\n     WHOLE AREA CLICKABLE\n  ========================== *\/\n  .st-easy-return-trigger {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n\n    width: 100%;\n    padding: 0;\n\n    background: transparent;\n    border: none;\n    border-radius: 18px;\n\n    font: inherit;\n    cursor: pointer;\n\n    transition:\n      transform 0.25s ease,\n      filter 0.25s ease;\n  }\n\n  \/* Whole image and button reaction *\/\n  .st-easy-return-trigger:hover {\n    transform: translateY(-5px) scale(1.04);\n    filter: brightness(1.04);\n  }\n\n  \/* Click\/tap reaction *\/\n  .st-easy-return-trigger:active {\n    transform: translateY(0) scale(0.95);\n  }\n\n  \/* Image glow *\/\n  .st-easy-return-trigger img {\n    transition:\n      transform 0.3s ease,\n      filter 0.3s ease;\n  }\n\n  .st-easy-return-trigger:hover img {\n    transform: scale(1.04);\n\n    filter:\n      drop-shadow(\n        0 7px 12px\n        rgba(118, 197, 213, 0.40)\n      );\n  }\n\n  \/* =========================\n     CLICK HERE BUTTON\n  ========================== *\/\n  .st-click-here {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    font-family: Poppins, sans-serif;\n    font-size: 12px;\n    font-weight: 800;\n\n    color: #ffffff;\n    background-color: #76C5D5;\n\n    text-transform: uppercase;\n    letter-spacing: 0.4px;\n\n    padding: 6px 14px;\n    margin-top: -4px;\n\n    border-radius: 20px;\n    line-height: 1.2;\n\n    pointer-events: none;\n\n    \/* Continuous pop *\/\n    animation:\n      st-click-pop\n      1.5s\n      ease-in-out\n      infinite;\n\n    box-shadow:\n      0 4px 12px\n      rgba(118, 197, 213, 0.40);\n  }\n\n  \/* =========================\n     BUTTON POP ANIMATION\n  ========================== *\/\n  @keyframes st-click-pop {\n\n    0%,\n    100% {\n      transform: scale(1);\n\n      box-shadow:\n        0 4px 12px\n        rgba(118, 197, 213, 0.40);\n    }\n\n    50% {\n      transform: scale(1.15);\n\n      box-shadow:\n        0 8px 20px\n        rgba(118, 197, 213, 0.80);\n    }\n\n  }\n\n  \/* Button changes when whole badge is hovered *\/\n  .st-easy-return-trigger:hover\n  .st-click-here {\n    background-color: #333333;\n\n    animation-play-state: paused;\n\n    transform: scale(1.12);\n  }\n\n  \/* Keyboard focus *\/\n  .st-easy-return-trigger:focus-visible {\n    outline:\n      3px solid\n      rgba(118, 197, 213, 0.55);\n\n    outline-offset: 4px;\n  }\n\n  \/* =========================\n     POPUP BACKGROUND\n  ========================== *\/\n  .st-pip-overlay {\n    position: fixed;\n    inset: 0;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    padding: 20px;\n\n    background:\n      rgba(0, 0, 0, 0.60);\n\n    opacity: 0;\n    visibility: hidden;\n\n    z-index: 999999;\n\n    transition:\n      opacity 0.30s ease,\n      visibility 0.30s ease;\n  }\n\n  \/* Popup open *\/\n  .st-pip-overlay.st-pip-open {\n    opacity: 1;\n    visibility: visible;\n  }\n\n  \/* =========================\n     POPUP WINDOW\n  ========================== *\/\n  .st-pip-window {\n    width: 90%;\n    max-width: 720px;\n    height: 80vh;\n\n    background: #ffffff;\n\n    border-radius: 18px;\n\n    overflow: hidden;\n\n    box-shadow:\n      0 20px 60px\n      rgba(0, 0, 0, 0.45);\n\n    transform:\n      scale(0.75)\n      translateY(30px);\n\n    transition:\n      transform 0.35s ease;\n  }\n\n  \/* Popup opening animation *\/\n  .st-pip-overlay.st-pip-open\n  .st-pip-window {\n    transform:\n      scale(1)\n      translateY(0);\n  }\n\n  \/* =========================\n     POPUP HEADER\n  ========================== *\/\n  .st-pip-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    height: 55px;\n\n    padding:\n      0 15px\n      0 20px;\n\n    background: #76C5D5;\n\n    color: #ffffff;\n\n    font-family: Poppins, sans-serif;\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  \/* =========================\n     CLOSE BUTTON\n  ========================== *\/\n  .st-pip-close {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    width: 36px;\n    height: 36px;\n\n    padding: 0;\n\n    border: none;\n    border-radius: 50%;\n\n    background:\n      rgba(255, 255, 255, 0.20);\n\n    color: #ffffff;\n\n    font-size: 25px;\n    line-height: 1;\n\n    cursor: pointer;\n\n    transition:\n      background 0.25s ease,\n      transform 0.25s ease;\n  }\n\n  .st-pip-close:hover {\n    background: #333333;\n\n    transform: rotate(90deg);\n  }\n\n  \/* =========================\n     POPUP CONTENT\n     NO IFRAME\n  ========================== *\/\n  .st-pip-content {\n    height:\n      calc(80vh - 55px);\n\n    overflow-y: auto;\n\n    padding: 25px;\n\n    font-family: Poppins, sans-serif;\n    color: #333333;\n\n    line-height: 1.7;\n\n    box-sizing: border-box;\n  }\n\n  .st-pip-content h2 {\n    margin-top: 0;\n\n    color: #76C5D5;\n\n    font-size: 24px;\n  }\n\n  .st-pip-content h3 {\n    margin-top: 22px;\n    margin-bottom: 7px;\n\n    color: #333333;\n\n    font-size: 17px;\n  }\n\n  .st-pip-content p {\n    margin-top: 0;\n\n    font-size: 14px;\n  }\n\n  \/* =========================\n     MOBILE STYLE\n  ========================== *\/\n  @media (max-width: 480px) {\n\n    .st-trust-badges {\n      margin: 10px 0;\n      padding: 10px 0;\n    }\n\n    .st-trust-badge {\n      flex: 0 0 33.333%;\n      max-width: 33.333%;\n      gap: 4px;\n    }\n\n    .st-trust-badge img {\n      max-width: 110px;\n    }\n\n    .st-click-here {\n      font-size: 11px;\n\n      padding:\n        5px\n        10px;\n    }\n\n    \/* Mobile popup *\/\n    .st-pip-overlay {\n      padding: 10px;\n    }\n\n    .st-pip-window {\n      width: 100%;\n      height: 85vh;\n\n      border-radius: 14px;\n    }\n\n    .st-pip-header {\n      height: 50px;\n\n      padding:\n        0 10px\n        0 15px;\n\n      font-size: 14px;\n    }\n\n    .st-pip-content {\n      height:\n        calc(85vh - 50px);\n\n      padding: 18px;\n\n      font-size: 13px;\n    }\n\n    .st-pip-content h2 {\n      font-size: 21px;\n    }\n\n  }\n\n  \/* =========================\n     REDUCED MOTION\n  ========================== *\/\n  @media (prefers-reduced-motion: reduce) {\n\n    .st-click-here {\n      animation: none;\n    }\n\n    .st-easy-return-trigger,\n    .st-pip-window {\n      transition: none;\n    }\n\n  }\n<\/style>\n\n\n<!-- =========================\n     TRUST BADGES\n========================= -->\n\n<div class=\"st-trust-badges\">\n\n  <!-- 1. 100% Pure Cotton -->\n  <div class=\"st-trust-badge\">\n    <img\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/100_cotton.webp?v=1786611091\"\n      alt=\"100% Pure Cotton\"\n      loading=\"lazy\"\n    >\n  <\/div>\n\n\n  <!-- 2. Signature Prints -->\n  <div class=\"st-trust-badge\">\n    <img\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Signature_Prints.webp?v=1786611091\"\n      alt=\"Signature Prints\"\n      loading=\"lazy\"\n    >\n  <\/div>\n\n\n  <!-- 3. Parent Child Bonding -->\n  <div class=\"st-trust-badge\">\n    <img\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Parent_Child_Bonding.webp?v=1786611091\"\n      alt=\"Parent Child Bonding\"\n      loading=\"lazy\"\n    >\n  <\/div>\n\n\n  <!-- 4. Shipping Worldwide -->\n  <div class=\"st-trust-badge\">\n    <img\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Shipping_Worldwide.webp?v=1786611091\"\n      alt=\"Shipping Worldwide\"\n      loading=\"lazy\"\n    >\n  <\/div>\n\n\n  <!-- 5. Free Delivery in India -->\n  <div class=\"st-trust-badge\">\n    <img\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Free_Delivery_in_india.webp?v=1786611090\"\n      alt=\"Free Delivery in India\"\n      loading=\"lazy\"\n    >\n  <\/div>\n\n\n  <!-- 6. Cash on Delivery -->\n  <div class=\"st-trust-badge\">\n    <img\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Cash_on_delivery.webp?v=1786611091\"\n      alt=\"Cash on Delivery\"\n      loading=\"lazy\"\n    >\n  <\/div>\n\n\n  <!-- 7. EASY 7 DAY RETURNS\n       WHOLE IMAGE + BUTTON CLICKABLE -->\n  <div class=\"st-trust-badge\">\n\n    <button\n      type=\"button\"\n      class=\"st-easy-return-trigger\"\n      id=\"st-open-pip\"\n      aria-label=\"Open Shipping and Returns Policy\"\n    >\n\n      <img\n        src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Easy_7_day_returns.webp?v=1786611598\"\n        alt=\"Easy 7 Day Returns\"\n        loading=\"lazy\"\n      >\n\n      <span class=\"st-click-here\">\n        Click Here\n      <\/span>\n\n    <\/button>\n\n  <\/div>\n\n\n  <!-- 8. Express Delivery Available -->\n  <div class=\"st-trust-badge\">\n    <img\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Express_delivery_available.webp?v=1786611091\"\n      alt=\"Express Delivery Available\"\n      loading=\"lazy\"\n    >\n  <\/div>\n\n\n  <!-- 9. Gift Wrap -->\n  <div class=\"st-trust-badge\">\n    <img\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/Gift_Wrap.webp?v=1786611090\"\n      alt=\"Gift Wrap\"\n      loading=\"lazy\"\n    >\n  <\/div>\n\n<\/div>\n\n<!-- =========================\n     SHIPPING & RETURNS POPUP\n========================= -->\n\n<div\n  class=\"st-pip-overlay\"\n  id=\"st-pip-overlay\"\n  aria-hidden=\"true\"\n>\n\n  <div\n    class=\"st-pip-window\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-label=\"Shipping and Returns Policy\"\n  >\n\n    <!-- Popup Header -->\n    <div class=\"st-pip-header\">\n\n      <span>\n        Shipping & Returns\n      <\/span>\n\n      <!-- Close Button -->\n      <button\n        type=\"button\"\n        class=\"st-pip-close\"\n        id=\"st-close-pip\"\n        aria-label=\"Close popup\"\n      >\n        ×\n      <\/button>\n\n    <\/div>\n\n\n    <!-- =========================\n         ADD YOUR EXACT SHIPPING\n         & RETURNS CONTENT HERE\n    ========================== -->\n\n    <div class=\"st-pip-content\">\n\n      <style>\n  \/* =========================================\n     STORY TAILOR – SHIPPING & RETURN POLICY\n     CLEAN DESIGN – NO LINES, NO BOXES\n  ========================================= *\/\n\n  .st-policy-page {\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 40px 24px 60px;\n    font-family: Poppins, Arial, sans-serif;\n    color: #333333;\n    line-height: 1.7;\n  }\n\n  \/* HEADINGS – NO HORIZONTAL LINES *\/\n  .st-policy-page h2 {\n    margin: 38px 0 16px;\n    padding: 0;\n    font-size: 25px;\n    font-weight: 700;\n    line-height: 1.35;\n    color: #222222;\n    border: none !important;\n  }\n\n  .st-policy-page h2:first-child {\n    margin-top: 0;\n    font-size: 30px;\n    text-align: center;\n  }\n\n  .st-policy-page h3,\n  .st-policy-page p {\n    margin: 0 0 16px;\n    padding: 0;\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.75;\n    color: #444444;\n  }\n\n  .st-policy-page ul,\n  .st-policy-page ol {\n    margin: 0 0 20px;\n    padding-left: 25px;\n  }\n\n  .st-policy-page li {\n    margin-bottom: 12px;\n    padding-left: 4px;\n    font-size: 16px;\n    line-height: 1.75;\n  }\n\n  .st-policy-page ul ul {\n    margin-top: 12px;\n    margin-bottom: 5px;\n  }\n\n  .st-policy-page a {\n    color: #222222;\n    font-weight: 600;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .st-policy-page a:hover {\n    opacity: 0.7;\n  }\n\n  \/* REMOVE ALL BACKGROUNDS, BOXES AND BORDERS *\/\n  .st-policy-page .st-intro,\n  .st-policy-page .st-address-box,\n  .st-policy-page .st-contact-box {\n    max-width: none;\n    margin: 0 0 25px;\n    padding: 0;\n    background: transparent !important;\n    border: none !important;\n    border-radius: 0;\n    box-shadow: none !important;\n  }\n\n  .st-policy-page .st-address-box p {\n    margin: 0;\n    line-height: 1.8;\n  }\n\n  .st-policy-page .st-contact-box ul {\n    margin-bottom: 0;\n  }\n\n  \/* MOBILE RESPONSIVE *\/\n  @media screen and (max-width: 749px) {\n\n    .st-policy-page {\n      padding: 28px 18px 45px;\n    }\n\n    .st-policy-page h2 {\n      margin-top: 30px;\n      font-size: 21px;\n    }\n\n    .st-policy-page h2:first-child {\n      font-size: 25px;\n    }\n\n    .st-policy-page h3,\n    .st-policy-page p,\n    .st-policy-page li {\n      font-size: 15px;\n    }\n\n    .st-policy-page ul,\n    .st-policy-page ol {\n      padding-left: 21px;\n    }\n  }\n<\/style>\n\n\n<div class=\"st-policy-page\">\n\n  <h2>Shipping, Exchange &amp; Refund Policy<\/h2>\n\n  <div class=\"st-intro\">\n    <p>\n      At <strong>Story Tailor<\/strong>, every garment is crafted with care and love for your little ones. We aim to make your shopping experience seamless and transparent. Please review our policy regarding shipping, exchanges, refunds, and cancellations below.\n    <\/p>\n  <\/div>\n\n\n  <h2>SHIPPING POLICY<\/h2>\n\n  <ul>\n    <li>\n      <strong>Free Shipping:<\/strong> We offer <strong>Free Shipping on all orders<\/strong> across India, with no minimum purchase required.\n    <\/li>\n\n    <li>\n      <strong>Dispatch &amp; Delivery:<\/strong> Orders are typically processed and dispatched within <strong>2–3 business days<\/strong>. Delivery times vary depending on your location and usually take <strong>5–7 business days<\/strong>.\n    <\/li>\n  <\/ul>\n\n\n  <h2>RETURN &amp; REFUND POLICY<\/h2>\n\n  <ul>\n\n    <li>\n      <strong>Non-Discounted Orders:<\/strong> All sales are final. We do not offer cash refunds or store credits for standard purchases once delivered in good condition.\n    <\/li>\n\n    <li>\n      <strong>Damaged, Defective, or Incorrect Products:<\/strong> In the rare event that you receive a damaged, defective, or incorrect product, we offer a full replacement or a complete refund.\n\n      <ul>\n\n        <li>\n          <strong>Claim Window:<\/strong> You must notify us within <strong>48 hours<\/strong> of receiving your parcel.\n        <\/li>\n\n        <li>\n          <strong>Process:<\/strong> Email us at\n          <a href=\"mailto:krishna@storytailor.in\">krishna@storytailor.in<\/a>\n          or WhatsApp us at <strong>+91 9558515045<\/strong> with clear photos\/videos of the damaged item and the shipping parcel.\n        <\/li>\n\n        <li>\n          <strong>Resolution:<\/strong> Once verified, we will arrange a return pick-up or cover the return shipping costs and issue a replacement or full refund to your original payment method.\n        <\/li>\n\n      <\/ul>\n    <\/li>\n\n  <\/ul>\n\n\n  <h2>SALE &amp; DISCOUNTED ITEMS<\/h2>\n\n  <ul>\n\n    <li>\n      <strong>All sale, promotional, and discounted items are final sale.<\/strong>\n    <\/li>\n\n    <li>\n      We <strong>do not accept returns, exchanges, or refunds<\/strong> on any items purchased during a sale or with discount codes, unless the product arrives damaged, defective, or incorrect.\n    <\/li>\n\n  <\/ul>\n\n\n  <h2>EXCHANGE POLICY (NON-SALE ITEMS ONLY)<\/h2>\n\n  <p>\n    While we do not offer standard returns or refunds for non-damaged items, we want to ensure your child gets the perfect fit. We offer <strong>size or style exchanges<\/strong> for full-priced items under the following conditions:\n  <\/p>\n\n\n  <h3><strong>Eligibility for Exchange<\/strong><\/h3>\n\n  <ul>\n\n    <li>\n      Exchange requests must be raised within <strong>7 days<\/strong> of receiving your parcel.\n    <\/li>\n\n    <li>\n      Items must be in their original condition—unused, unwashed, unsoiled, and with all original tags and packaging intact.\n    <\/li>\n\n    <li>\n      <strong>Custom\/Personalized Orders<\/strong> and <strong>Sale Items<\/strong> are not eligible for exchange.\n    <\/li>\n\n  <\/ul>\n\n\n  <h3><strong>How the Exchange Process Works<\/strong><\/h3>\n\n  <ol>\n\n    <li>\n      <strong>Raise a Request:<\/strong> Contact our team via email at\n      <a href=\"mailto:krishna@storytailor.in\">krishna@storytailor.in<\/a>\n      or WhatsApp us at <strong>+91 9558515045<\/strong> with your Order ID and the requested exchange size or style.\n    <\/li>\n\n    <li>\n      <strong>Ship the Item Back:<\/strong> Customers are required to self-ship the item(s) back to our facility in secure, original packaging.\n    <\/li>\n\n  <\/ol>\n\n\n  <div class=\"st-address-box\">\n\n    <p>\n      <strong><em>Ship-Back Address:<\/em><\/strong><br>\n\n      <strong>Story Tailor<\/strong><br>\n\n      Keshav A-3, Vrindavan Park,<br>\n\n      Near Parshvanath Flats,<br>\n\n      Beside Mehsananagar Ground,<br>\n\n      Nizampura, Vadodara – 390002,<br>\n\n      Gujarat, India.<br>\n\n      <strong>Phone: +91 9558515045<\/strong>\n    <\/p>\n\n  <\/div>\n\n\n  <ol start=\"3\">\n\n    <li>\n      <strong>Quality Check:<\/strong> Once we receive the returned item, our team will inspect it to ensure it meets our exchange criteria.\n    <\/li>\n\n    <li>\n      <strong>Dispatch of Replacement:<\/strong> Upon successful verification, we will ship the replacement product or size to you with <strong>Free Shipping<\/strong>.\n    <\/li>\n\n  <\/ol>\n\n\n  <h2>CANCELLATION POLICY<\/h2>\n\n  <ul>\n\n    <li>\n      You can cancel your order within <strong>24 hours of placing it<\/strong> or before it is dispatched, whichever is earlier.\n    <\/li>\n\n    <li>\n      Once an order has been shipped, it cannot be cancelled.\n    <\/li>\n\n  <\/ul>\n\n\n  <h2>HAVE QUESTIONS? WE'RE HERE TO HELP!<\/h2>\n\n  <p>\n    If you have any questions regarding sizing, fabric, or your order status, please reach out to us:\n  <\/p>\n\n\n  <div class=\"st-contact-box\">\n\n    <ul>\n\n      <li>\n        <strong>Email:<\/strong>\n        krishna@storytailor.in\n      <\/li>\n\n      <li>\n        <strong>WhatsApp\/Call:<\/strong> +91 9558515045\n      <\/li>\n\n      <li>\n        <strong>Working Hours:<\/strong> Monday – Saturday, 10:00 AM – 6:00 PM IST\n      <\/li>\n    <\/ul>\n  <\/div>\n<\/div>    <\/div>\n\n  <\/div>\n\n<\/div>\n\n<!-- =========================\n     POPUP JAVASCRIPT\n========================= -->\n\n<script>\n\n  const stOpenButton =\n    document.getElementById(\n      \"st-open-pip\"\n    );\n\n  const stCloseButton =\n    document.getElementById(\n      \"st-close-pip\"\n    );\n\n  const stPopup =\n    document.getElementById(\n      \"st-pip-overlay\"\n    );\n\n\n  \/* Open popup *\/\n\n  stOpenButton.addEventListener(\n    \"click\",\n    function () {\n\n      stPopup.classList.add(\n        \"st-pip-open\"\n      );\n\n      stPopup.setAttribute(\n        \"aria-hidden\",\n        \"false\"\n      );\n\n      \/* Stop background scrolling *\/\n\n      document.body.style.overflow =\n        \"hidden\";\n\n    }\n  );\n\n\n  \/* Close popup function *\/\n\n  function stClosePopup() {\n\n    stPopup.classList.remove(\n      \"st-pip-open\"\n    );\n\n    stPopup.setAttribute(\n      \"aria-hidden\",\n      \"true\"\n    );\n\n    \/* Enable background scrolling *\/\n\n    document.body.style.overflow =\n      \"\";\n\n  }\n\n\n  \/* Close using × *\/\n\n  stCloseButton.addEventListener(\n    \"click\",\n    stClosePopup\n  );\n\n\n  \/* Close by clicking outside *\/\n\n  stPopup.addEventListener(\n    \"click\",\n    function (event) {\n\n      if (\n        event.target ===\n        stPopup\n      ) {\n\n        stClosePopup();\n\n      }\n\n    }\n  );\n\n\n  \/* Close using Escape *\/\n\n  document.addEventListener(\n    \"keydown\",\n    function (event) {\n\n      if (\n        event.key ===\n        \"Escape\"\n      ) {\n\n        stClosePopup();\n\n      }\n\n    }\n  );\n\n<\/script>"}},"liquid_JmnnpM":{"type":"liquid","name":"Gift Box","settings":{"liquid":"{% if linklists.gift-wrapping.links.siz