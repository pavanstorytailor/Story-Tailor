IFT_BOX-07.png?v=1763125433\"><\/a> <a href=\"https:\/\/storytailor.in\/pages\/buy-3-t-shirts-at-999\"><img style=\"display: inline;\" width=\"100px\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/GIFT_BOX-08.png?v=1763125433\"><\/a><\/p>\n  <\/div>\n\n<\/div>\n\n<script>\n\/\/ Get the modal\nvar modal = document.getElementById(\"myModal\");\n\n\/\/ Get the button that opens the modal\nvar btn = document.getElementById(\"myBtn\");\n\n\/\/ Get the <span> element that closes the modal\nvar span = document.getElementsByClassName(\"close\")[0];\n\n\/\/ When the user clicks the button, open the modal \nbtn.onclick = function() {\n  modal.style.display = \"block\";\n}\n\n\/\/ When the user clicks on <span> (x), close the modal\nspan.onclick = function() {\n  modal.style.display = \"none\";\n}\n\n\/\/ When the user clicks anywhere outside of the modal, close it\nwindow.onclick = function(event) {\n  if (event.target == modal) {\n    modal.style.display = \"none\";\n  }\n}\n<\/script>"}},"custom_html_QqArjq":{"type":"custom-html","name":"Shop By Stories Video","settings":{"subheading":"","title":"","html":"<style>\n@media screen and (min-width: 700px){\n.myrow{\ndisplay: flex;\n}\n.mycol2{\nwidth:49%;\npadding: 0 20px;\n}\n}\n@media screen and (max-width: 700px){\n.myrow{\ndisplay: block;\n}\n.mycol2{\nwidth: 100%;\npadding: 0;\n}\n}\n.video_banner_section video{\nborder-radius:10px;\n}\n@media screen and (min-width: 700px){\n.illus-1{position:relative;}\n.illus-1 img{\nposition: absolute;\nwidth:80px;\ntop:-130px;\nright:20%;\nmargin:0;\n}\n}\n@media screen and (max-width: 700px){\n.illus-1{position: relative !important;}\n.illus-1 img{\nposition: absolute !important;\nwidth:80px;\ntop:-130px;\nright:0px;\nmargin:0 !important;\n}\n}\n<\/style>\n<div class=\"illus-1 scroll-item\" data-speed=\"0.1\" data-direction=\"right\"><img class=\"illus-1-img\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0688\/4091\/5223\/files\/illustrations-12.webp?v=176197