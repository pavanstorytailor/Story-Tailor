{%- assign for_drawer = false -%}

{%- if section.id == 'mini-cart' -%}
  {%- assign for_drawer = true -%}
{%- endif -%}

<div class="Cart__ItemList">
  {%- unless for_drawer -%}
    <div class="Cart__Head hidden-phone">
      <span class="Cart__HeadItem Heading Text--subdued u-h7">{{ 'cart.items.product' | t }}</span>
      <span class="Cart__HeadItem"></span>
      <span class="Cart__HeadItem Heading Text--subdued u-h7" style="text-align: center">{{ 'cart.items.quantity' | t }}</span>
      <span class="Cart__HeadItem Heading Text--subdued u-h7" style="text-align: right">{{ 'cart.items.total' | t }}</span>
    </div>
  {%- endunless -%}

  {%- assign gift_item_markup = '' -%}
  {%- assign premium_gift_box_markup = '' -%}
  {%- assign regular_items_markup = '' -%}
  {%- assign free_gift_variant_id = 54684641886487 -%}
  {%- assign premium_gift_box_variant_id = 54540457804055 -%}
  {%- assign premium_gift_box_threshold = 200000 -%}

  {%- assign premium_gift_box_qualifying_total = cart.total_price -%}
  {%- for item in cart.items -%}
    {%- assign item_title_lower = item.product.title | downcase | strip -%}
    {%- if item.variant_id == free_gift_variant_id or item.product.handle == 'handmade-soft-toy' or item.variant_id == premium_gift_box_variant_id or item_title_lower == 'gift box' or item_title_lower == 'premium gift box' -%}
      {%- assign premium_gift_box_qualifying_total = premium_gift_box_qualifying_total | minus: item.final_line_price -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign premium_gift_box_is_free = false -%}
  {%- if premium_gift_box_qualifying_total >= premium_gift_box_threshold -%}
    {%- assign premium_gift_box_is_free = true -%}
  {%- endif -%}

  {%- for line_item in cart.items -%}
    {%- assign product_title_lower = line_item.product.title | downcase | strip -%}
    {%- assign product_handle_lower = line_item.product.handle | downcase | strip -%}
    {%- assign is_free_gift_item = false -%}
    {%- assign is_premium_gift_box_item = false -%}
    {%- assign is_free_premium_gift_box_item = false -%}
    {%- assign is_sleepwear_item = false -%}
    {%- for collection in line_item.product.collections -%}
      {%- if collection.handle == 'sleepwear' -%}
        {%- assign is_sleepwear_item = true -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if product_handle_lower == 'handmade-soft-toy' or line_item.variant_id == free_gift_variant_id -%}
      {%- assign is_free_gift_item = true -%}
    {%- endif -%}
    {%- if line_item.variant_id == premium_gift_box_variant_id or product_title_lower == 'gift box' or product_title_lower == 'premium gift box' -%}
      {%- assign is_premium_gift_box_item = true -%}
      {%- if line_item.final_price == 0 or premium_gift_box_is_free -%}
        {%- assign is_free_premium_gift_box_item = true -%}
      {%- endif -%}
    {%- endif -%}

    {%- capture cart_item_markup -%}
      {%- if for_drawer -%}
        <div class="CartItemWrapper">
      {%- endif -%}

      <div class="CartItem {% if is_premium_gift_box_item %}GiftBoxItem{% elsif product_title_lower == 'check' or product_title_lower contains 'giraffe plush toys' %}CheckItem{% endif %}{% if is_free_gift_item %} CartItem--freeGift{% endif %}">
        <div class="CartItem__ImageWrapper AspectRatio">
          <div class="AspectRatio" style="--aspect-ratio: {{ line_item.image.aspect_ratio }}">
            <a href="{{ line_item.url }}">
              <img class="CartItem__Image" src="{{ line_item.image | img_url: '240x' }}" alt="{{ line_item.image.alt | escape }}">
            </a>
          </div>
        </div>

        <div class="CartItem__Info">
          <h2 class="CartItem__Title Heading">
            <a href="{{ line_item.url }}">{{ line_item.product.title }}</a>
          </h2>

          <div class="CartItem__Meta Heading Text--subdued">
            {%- unless line_item.product.has_only_default_variant -%}
              <p class="CartItem__Variant">{{ line_item.variant.title }}</p>
            {%- endunless -%}

            {%- if line_item.selling_plan_allocation -%}
              <p class="CartItem__PlanAllocation">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
            {%- endif -%}

            {%- if line_item.properties != empty -%}
              <ul class="CartItem__PropertyList">
                {%- for property in line_item.properties -%}
                  {%- assign first_character_in_key = property.first | truncate: 1, '' -%}

                  {%- if property.last == blank or first_character_in_key == '_' -%}
                    {%- continue -%}
                  {%- endif -%}

                  <li class="CartItem__Property">{{ property.first }}: {{ property.last }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="CartItem__PriceList">
              {%- if is_free_gift_item or is_free_premium_gift_box_item or line_item.final_price == 0 -%}
                <span class="CartItem__Price CartItem__Price--freeGift">
                  <span class="CartItem__OriginalPrice Price Price--compareAt">{{ line_item.original_price | money }}</span>
                  <span class="CartItem__FreeTag">Free</span>
                  <span class="CartItem__GiftQty">Qty {{ line_item.quantity }}</span>
                </span>
              {%- elsif line_item.original_price != line_item.final_price -%}
                <span class="CartItem__Price Price Price--highlight">{{ line_item.final_price | money }}</span>
                <span class="CartItem__OriginalPrice Price Price--compareAt">{{ line_item.original_price | money }}</span>
              {%- else -%}
                <span class="CartItem__Price Price">{{ line_item.final_price | money }}</span>
              {%- endif -%}

              {%- if line_item.line_level_discount_allocations != blank -%}
                <ul class="CartItem__DiscountList">
                  {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                    {%- if discount_allocation.amount > 0 -%}
                      <li class="CartItem__Discount">
                        {%- render 'icon' with 'sale' -%}{{ discount_allocation.discount_application.title }}: -{{ discount_allocation.amount | money }}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

            {%- if line_item.unit_price_measurement -%}
              <div class="CartItem__UnitPriceMeasurement">
                <div class="UnitPriceMeasurement Heading Text--subdued">
                  <span class="UnitPriceMeasurement__Price">{{ line_item.unit_price | money }}</span>
                  <span class="UnitPriceMeasurement__Separator">/ </span>

                  {%- if line_item.unit_price_measurement.reference_value != 1 -%}
                    <span class="UnitPriceMeasurement__ReferenceValue">{{ line_item.unit_price_measurement.reference_value }}</span>
                  {%- endif -%}

                  <span class="UnitPriceMeasurement__ReferenceUnit">{{ line_item.unit_price_measurement.reference_unit }}</span>
                </div>
              </div>
            {%- endif -%}
          </div>

          {%- capture item_actions -%}
            {% assign is_addon_item = false %}
            {% if is_premium_gift_box_item or product_title_lower == 'check' or product_title_lower contains 'giraffe plush toys' or product_handle_lower == 'handmade-soft-toy' or line_item.variant_id == free_gift_variant_id %}
              {% assign is_addon_item = true %}
            {% endif %}

            {% if is_free_gift_item %}
              <div class="CartItem__Actions CartItem__Actions--freeGift Heading Text--subdued" style="text-align: center">
                <a href="{{ routes.cart_change_url }}?quantity=0&line={{ forloop.index }}"
                  class="CartItem__Remove Link Link--underline Link--underlineShort"
                  data-quantity="0"
                  data-line="{{ forloop.index }}"
                  data-action="remove-item">

                  {{ 'cart.items.remove' | t }}

                </a>
              </div>
            {% elsif is_premium_gift_box_item %}
              <div class="CartItem__Actions Heading Text--subdued" style="text-align: center">
                <div class="CartItem__QuantitySelector CartItem__QuantitySelector--disabled">
                  <div class="QuantitySelector QuantitySelector--disabled" aria-disabled="true">
                    <span class="QuantitySelector__Button Link Link--primary is-disabled" aria-hidden="true">-</span>
                    <input
                      type="text"
                      class="QuantitySelector__CurrentQuantity"
                      value="{{ line_item.quantity }}"
                      readonly
                      tabindex="-1"
                      aria-label="Gift box quantity"
                    >
                    <span class="QuantitySelector__Button Link Link--primary is-disabled" aria-hidden="true">+</span>
                  </div>
                </div>

                <a href="{{ routes.cart_change_url }}?quantity=0&line={{ forloop.index }}"
                  class="CartItem__Remove Link Link--underline Link--underlineShort"
                  data-quantity="0"
                  data-line="{{ forloop.index }}"
                  data-action="remove-item">

                  {{ 'cart.items.remove' | t }}

                </a>
              </div>
            {% elsif is_addon_item %}
            {% else %}
              <div class="CartItem__Actions Heading Text--subdued" style="text-align: center">
                {% comment %}
                <div class="CartItem__QuantitySelector">
                  <div class="QuantitySelector">
                    {%- assign quantity_minus_one = line_item.quantity | minus: 1 -%}

                    <a class="QuantitySelector__Button Link Link--primary" title="{{ 'cart.items.set_quantity' | t: new_quantity: quantity_minus_one }}" href="{{ routes.cart_change_url }}?quantity={{ quantity_minus_one }}&line={{ forloop.index }}" data-quantity="{{ quantity_minus_one }}" data-line="{{ forloop.index }}" data-action="update-item-quantity">
                      {%- render 'icon' with 'minus' -%}
                    </a>

                    <input type="text" name="updates[]" id="updates_{{ line_item.key }}" class="QuantitySelector__CurrentQuantity" pattern="[0-9]*" data-line="{{ forloop.index }}" value="{{ line_item.quantity }}">

                    {%- assign quantity_plus_one = line_item.quantity | plus: 1 -%}

                    <a class="QuantitySelector__Button Link Link--primary" title="{{ 'cart.items.set_quantity' | t: new_quantity: quantity_plus_one }}" href="{{ routes.cart_change_url }}?quantity={{ quantity_plus_one }}&line={{ forloop.index }}" data-quantity="{{ quantity_plus_one }}" data-line="{{ forloop.index }}" data-action="update-item-quantity">
                      {%- render 'icon' with 'plus' -%}
                    </a>
                  </div>
                </div>

                <a href="{{ routes.cart_change_url }}?quantity=0&line={{ forloop.index }}" class="CartItem__Remove Link Link--underline Link--underlineShort" data-quantity="0" data-line="{{ forloop.index }}" data-action="remove-item">{{ 'cart.items.remove' | t }}</a>
                {% endcomment %}

                <div class="CartItem__QuantitySelector">
                  <div class="QuantitySelector">
                    {%- assign quantity_minus_one = line_item.quantity | minus: 1 -%}

                    <a class="QuantitySelector__Button Link Link--primary"
                      href="{{ routes.cart_change_url }}?quantity={{ quantity_minus_one }}&line={{ forloop.index }}"
                      data-quantity="{{ quantity_minus_one }}"
                      data-line="{{ forloop.index }}"
                      data-action="update-item-quantity">

                      {%- render 'icon' with 'minus' -%}

                    </a>

                    <input
                      type="text"
                      name="updates[]"
                      id="updates_{{ line_item.key }}"
                      class="QuantitySelector__CurrentQuantity"
                      pattern="[0-9]*"
                      data-line="{{ forloop.index }}"
                      value="{{ line_item.quantity }}">

                    {%- assign quantity_plus_one = line_item.quantity | plus: 1 -%}

                    <a class="QuantitySelector__Button Link Link--primary"
                      href="{{ routes.cart_change_url }}?quantity={{ quantity_plus_one }}&line={{ forloop.index }}"
                      data-quantity="{{ quantity_plus_one }}"
                      data-line="{{ forloop.index }}"
                      data-action="update-item-quantity">

                      {%- render 'icon' with 'plus' -%}

                    </a>
                  </div>
                </div>

                <a href="{{ routes.cart_change_url }}?quantity=0&line={{ forloop.index }}"
                  class="CartItem__Remove Link Link--underline Link--underlineShort"
                  data-quantity="0"
                  data-line="{{ forloop.index }}"
                  data-action="remove-item">

                  {{ 'cart.items.remove' | t }}

                </a>

              </div>
            {% endif %}
          {%- endcapture -%}

          {{ item_actions }}
        </div>

        {%- unless for_drawer -%}
          {{ item_actions }}

          <div class="CartItem__LinePriceList Heading Text--subdued" style="text-align: right">
            {%- if is_free_gift_item or is_free_premium_gift_box_item or line_item.final_price == 0 -%}
              <span class="CartItem__Price CartItem__Price--freeGift">
                <span class="CartItem__OriginalPrice Price Price--compareAt">{{ line_item.original_line_price | money }}</span>
                <span class="CartItem__FreeTag">Free</span>
                <span class="CartItem__GiftQty">Qty {{ line_item.quantity }}</span>
              </span>
            {%- elsif line_item.original_line_price != line_item.final_line_price -%}
              <span class="CartItem__Price Price Price--highlight">{{ line_item.final_line_price | money }}</span>
              <span class="CartItem__Price Price Price--compareAt">{{ line_item.original_line_price | money }}</span>
            {%- else -%}
              <span class="CartItem__Price Price">{{ line_item.final_line_price | money }}</span>
            {%- endif -%}
          </div>
        {%- endunless -%}
      </div>

      {%- if for_drawer -%}
        </div>
      {%- endif -%}
    {%- endcapture -%}

    {%- if is_free_gift_item -%}
      {%- assign gift_item_markup = cart_item_markup -%}
    {%- elsif is_premium_gift_box_item -%}
      {%- assign premium_gift_box_markup = premium_gift_box_markup | append: cart_item_markup -%}
    {%- else -%}
      {%- assign regular_items_markup = regular_items_markup | append: cart_item_markup -%}
    {%- endif -%}
  {%- endfor -%}

  {{ gift_item_markup }}
  {{ premium_gift_box_markup }}
  {{ regular_items_markup }}
</div>
